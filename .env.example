# =============================================================================
# Foodcraft — ตั้งค่าเกม (ทุก key บังคับ)
# =============================================================================
# โหลดตอน Nakama start — ขาดหรือผิดรูปแบบ → server ไม่ขึ้น (ดู error ใน log)
# แก้แล้ว: make rebuild
#
# เนื้อหาเกม (ชื่อเมนู/สูตร): modules/data/game_data.json
# ป้ายชื่อระดับร้าน (ไทย): game_data.json → shop.rarity_labels
# Client รับค่าที่เกี่ยว UI ผ่าน get_game_config ตอน login (ไม่ต้อง build client ใหม่)
# =============================================================================

# -----------------------------------------------------------------------------
# รางวัลรายวัน
# -----------------------------------------------------------------------------
# เหรียญที่ผู้เล่นได้เมื่อกดรับรางวัลรายวัน (1 ครั้งต่อวัน เที่ยงคืน UTC)
# แก้แล้ว: จำนวนเหรียญในแท็บร้าน + ที่ได้จริงจาก claim_daily_reward
DAILY_REWARD_COINS=120

# -----------------------------------------------------------------------------
# รางวัลเมื่อค้นพบเมนู/วัตถุดิบใหม่ (หลัง craft สำเร็จบน server)
# -----------------------------------------------------------------------------
# โอกาสได้ดาวแทนเหรียญ (0–100) เมื่อค้นพบของใหม่
# แก้แล้ว: ยิ่งสูง ผู้เล่นได้ดาวบ่อยขึ้น / เหรียญจาก discovery น้อยลง
REWARD_STAR_PERCENT=28

# สูตรเหรียญ: BASE + (tier × PER_TIER) + สุ่ม 0 ถึง (tier × RANDOM_PER_TIER)
# แก้ BASE/PER_TIER/RANDOM → ปรับเหรียญเฉลี่ยต่อ tier เมนูที่ค้นพบใหม่
REWARD_COIN_BASE=10
REWARD_COIN_PER_TIER=12
REWARD_COIN_RANDOM_PER_TIER=8

# ดาวที่ได้เมื่อสุ่มถูก: tier ≤ THRESHOLD → LOW, มากกว่า → HIGH
# แก้แล้ว: จำนวนดาวต่อการค้นพบ (เมนู tier สูงได้มากกว่าถ้า HIGH > LOW)
REWARD_STAR_AMOUNT_LOW=1
REWARD_STAR_AMOUNT_HIGH=2
REWARD_STAR_TIER_THRESHOLD=2

# -----------------------------------------------------------------------------
# Rate limit — กัน spam RPC (ไม่แสดงข้อความให้ผู้เล่น)
# -----------------------------------------------------------------------------
# ระยะห่างขั้นต่ำระหว่าง craft ต่อ user (มิลลิวินาที)
# แก้แล้ว: ค่าน้อย = ผสมถี่ได้ / ค่ามาก = ช้าลง กัน bot
RATE_LIMIT_CRAFT_MS=400

# ระยะห่างขั้นต่ำระหว่างซื้อวัตถุดิบจากร้าน (มิลลิวินาที)
RATE_LIMIT_PURCHASE_MS=300

# ระยะห่างขั้นต่ำระหว่างกดรับรางวัลรายวัน (วินาที)
RATE_LIMIT_DAILY_SEC=3

# -----------------------------------------------------------------------------
# แต้มค้นพบ (ลีดเดอร์บอร์ด "ชื่อเสียง" + แสดงในโปรไฟล์)
# -----------------------------------------------------------------------------
# แต้มพื้นฐานต่อเมนู = tier × ค่านี้
# แก้แล้ว: ยิ่งสูง คะแนนลีดเดอร์บอร์ดชื่อเสียงโตเร็วขึ้น
DISCOVERY_POINTS_PER_TIER=10

# โบนัสต่อจำนวนสูตรที่ "ใช้เมนูนี้เป็นวัตถุดิบ" (สาขาใน tree)
# bonus = min(จำนวนสาขา × ค่านี้, DISCOVERY_BRANCH_BONUS_MAX)
DISCOVERY_BRANCH_BONUS=2
DISCOVERY_BRANCH_BONUS_MAX=30

# -----------------------------------------------------------------------------
# ลีดเดอร์บอร์ด
# -----------------------------------------------------------------------------
# จำนวนเมนูที่ต้องค้นพบครบเพื่อบันทึก milestone ความเร็ว (บอร์ด 1 และ 2)
# แก้แล้ว: เป้าหมายบอร์ด "ความเร็ว X เมนู" + ชื่อ/คำอธิบายในเกม
LEADERBOARD_MILESTONE_MENU_1=100
LEADERBOARD_MILESTONE_MENU_2=500

# คะแนนความเร็ว = ค่านี้ − เวลา (unix) ตอนถึง milestone (ยิ่งเร็วคะแนนยิ่งสูง)
LEADERBOARD_SPEED_SCORE_BASE=2000000000

# เมนู tier ≥ ค่านี้ นับในลีดเดอร์บอร์ด "นักล่าของหายาก"
# แก้แล้ว: ลดลง = เมนู tier ต่ำกว่านับเป็นหายากด้วย
LEADERBOARD_RARE_TIER_MIN=3

# -----------------------------------------------------------------------------
# โฆษณา / แพ็กเริ่มต้น (ข้อความบน client — ยังไม่มี IAP จริง)
# -----------------------------------------------------------------------------
# เหรียญที่แสดงในร้านสำหรับ "ดูโฆษณา" (ยังไม่จ่ายจริงจนกว่าจะเชื่อม AdMob)
AD_REWARD_COINS=80

# เหรียญที่แสดงในแพ็กเริ่มต้น (ยังไม่จ่ายจริงจนกว่าจะเชื่อม store)
STARTER_PACK_COINS=500

# =============================================================================
# ร้านวัตถุดิบ (สุ่มใหม่ทุกเที่ยงคืน UTC)
# =============================================================================

# จำนวนวัตถุดิบที่สุ่มมาวางขายต่อวัน (ไม่ซ้ำในชุดเดียวกัน)
# แก้แล้ว: ร้านโชว์กี่ช่องต่อวัน
SHOP_ROTATION_COUNT=8

# น้ำหนักการสุ่มแต่ละระดับ — ยิ่งสูง โอกาสถูกเลือกต่อการจับ 1 ครั้งยิ่งมาก
# แก้แล้ว: ความถี่ที่ common/uncommon/rare/epic/legendary โผล่ในร้าน
SHOP_WEIGHT_COMMON=50
SHOP_WEIGHT_UNCOMMON=25
SHOP_WEIGHT_RARE=15
SHOP_WEIGHT_EPIC=7
SHOP_WEIGHT_LEGENDARY=3

# ราคาเหรียญเมื่อซื้อปลดล็อกวัตถุดิบ (server หัก wallet จริง)
# แก้แล้ว: เหรียญที่หักตอนกดซื้อ — ไม่กระทบว่าจะโผล่ในร้านหรือไม่
SHOP_COST_COMMON=80
SHOP_COST_UNCOMMON=150
SHOP_COST_RARE=280
SHOP_COST_EPIC=450
SHOP_COST_LEGENDARY=700

# Hint: กดขอเบาะแสสูตร หักดาวกี่เม็ดต่อครั้ง
HINT_COST_STARS=2
