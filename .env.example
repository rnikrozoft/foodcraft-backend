# =============================================================================
# ตั้งค่าร้านค้าวัตถุดิบ (Foodcraft Shop)
# =============================================================================
# โหลดตอน Nakama เริ่มทำงาน (อ่านจาก shop_env.go)
# แก้แล้วต้อง restart: make rebuild
#
# ค่าในไฟล์นี้จะ override ค่าใน modules/data/game_data.json (เฉพาะฝั่ง server)
# Client รับค่าล่าสุดผ่าน RPC get_game_config ตอน login
#
# หมายเหตุ: หน้า Nakama Console > Server Configuration คือ local.yml
# (logger, port, session) — ไม่ใช่ไฟล์นี้
# =============================================================================

# จำนวนวัตถุดิบที่สุ่มมาขายต่อวัน (ต่อรอบ auto-reset เที่ยงคืน UTC)
# เปลี่ยนแล้ว: ร้านแสดงกี่ชิ้นต่อวัน (ไม่ซ้ำในชุดเดียวกัน)
# ตัวอย่าง: 8 = สุ่ม 8 ชิ้นจากพูลที่ยังไม่ปลดล็อก
SHOP_ROTATION_COUNT=8

# -----------------------------------------------------------------------------
# น้ำหนักการสุ่ม (Rotation Weights)
# -----------------------------------------------------------------------------
# ใช้ตอน rollShopRotation() — สุ่มทีละชิ้น แล้วเอาออกจากพูล
# ยิ่งเลขสูง = โอกาสถูกเลือกต่อการจับ 1 ครั้งยิ่งมาก
# สัดส่วนไม่จำเป็นต้องรวม 100 (ระบบคำนวณจากผลรวมอัตโนมัติ)
#
# เปลี่ยนแล้ว: ความถี่ที่แต่ละระดับโผล่ในร้านรายวัน
# ตัวอย่าง: SHOP_WEIGHT_RARE=30 → แรร์ออกบ่อยขึ้นเทียบกับ common

# ธรรมดา (common) — วัตถุดิบระดับต่ำสุดในพูล
SHOP_WEIGHT_COMMON=50

# หายาก (uncommon)
SHOP_WEIGHT_UNCOMMON=25

# แรร์ (rare)
SHOP_WEIGHT_RARE=15

# เอปิค (epic)
SHOP_WEIGHT_EPIC=7

# ตำนาน (legendary) — หายากที่สุดในพูล
SHOP_WEIGHT_LEGENDARY=3

# -----------------------------------------------------------------------------
# ราคาซื้อด้วยเหรียญ (Coin Costs)
# -----------------------------------------------------------------------------
# ราคาต่อชิ้นเมื่อผู้เล่นกดซื้อปลดล็อกวัตถุดิบ
# ระดับ rarity ของแต่ละวัตถุดิบกำหนดจาก catalog (แบ่งตามลำดับในรายการ)
#
# เปลี่ยนแล้ว: เหรียญที่หักตอนซื้อ (ฝั่ง server เป็นคนตัด wallet)
# ไม่กระทบการสุ่มว่าจะโผล่หรือไม่

# ราคาวัตถุดิบระดับธรรมดา (เหรียญ)
SHOP_COST_COMMON=80

# ราคาวัตถุดิบระดับหายาก
SHOP_COST_UNCOMMON=150

# ราคาวัตถุดิบระดับแรร์
SHOP_COST_RARE=280

# ราคาวัตถุดิบระดับเอปิค
SHOP_COST_EPIC=450

# ราคาวัตถุดิบระดับตำนาน
SHOP_COST_LEGENDARY=700
